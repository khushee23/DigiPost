# Post Office Automation System - Frontend Environment Config

# URL of the Node.js / Express backend server
VITE_API_BASE_URL=http://localhost:5000/api

# Mock API toggle:
# Set to 'true' to run fully interactive in-memory/localStorage mock mode (perfect for frontend demo and testing before backend is deployed)
# Set to 'false' to route all API calls to the live Node.js/Express backend at VITE_API_BASE_URL
VITE_USE_MOCK_API=true
