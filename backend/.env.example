# Copy this file to .env and fill in your own values (never commit .env)
PORT=5000
NODE_ENV=development

# Origin(s) of the React app allowed to call this API (comma-separated)
CLIENT_URL=http://localhost:5173

# Supabase project (Project Settings -> API). Use the service_role key here:
# it stays on the server only and must NEVER be exposed in the frontend.
SUPABASE_URL=
SUPABASE_KEY=

# Long random string used to sign login tokens, e.g. run: openssl rand -hex 32
JWT_SECRET=
